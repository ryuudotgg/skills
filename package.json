{
  "name": "skills",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "tegami": "bun packages/cli/src/release/tegami.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings packages/cli/src skills/*/reviewer.ts skills/playbook/opencode/*.ts apps/docs",
    "format": "oxfmt --check packages/cli/src skills/*/reviewer.ts skills/playbook/opencode/*.ts apps/docs",
    "stanza": "stanza --check packages/cli/src skills/*/reviewer.ts skills/playbook/opencode/*.ts apps/docs",
    "fix": "oxlint --fix packages/cli/src skills/*/reviewer.ts skills/playbook/opencode/*.ts apps/docs && oxfmt packages/cli/src skills/*/reviewer.ts skills/playbook/opencode/*.ts apps/docs && stanza --fix packages/cli/src skills/*/reviewer.ts skills/playbook/opencode/*.ts apps/docs"
  },
  "devDependencies": {
    "@ryuugg/stanza": "0.1.2",
    "@types/bun": "1.4.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tegami": "1.5.0",
    "typescript": "7.0.2"
  }
}
