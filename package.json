{
  "name": "skills-cli",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src skills/*/reviewer.ts docs",
    "format": "oxfmt --check src skills/*/reviewer.ts docs",
    "stanza": "stanza --check src skills/*/reviewer.ts docs",
    "fix": "oxlint --fix src skills/*/reviewer.ts docs && oxfmt src skills/*/reviewer.ts docs && stanza --fix src skills/*/reviewer.ts docs"
  },
  "devDependencies": {
    "@ryuugg/stanza": "0.1.2",
    "@types/bun": "1.4.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  }
}
