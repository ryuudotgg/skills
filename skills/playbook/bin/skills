#!/bin/sh
set -eu

script=$0
case "$script" in
  */*) ;;
  *) script=./$script ;;
esac

while [ -L "$script" ]; do
  target=$(readlink "$script")
  case "$target" in
    /*) script=$target ;;
    *) script=${script%/*}/$target ;;
  esac
done

directory=$(CDPATH= cd -P "${script%/*}" && pwd)
repo=${directory%/skills/playbook/bin}

bun=
if command -v bun >/dev/null 2>&1; then
  bun=bun
else
  for candidate in "$HOME/.bun/bin/bun" /opt/homebrew/bin/bun /usr/local/bin/bun; do
    if [ -x "$candidate" ]; then
      bun=$candidate
      PATH=${candidate%/*}:$PATH
      export PATH
      break
    fi
  done
fi

if [ -z "$bun" ]; then
  printf '%s\n' 'skills: install Bun 1.4.0 or newer and put bun on PATH or in ~/.bun/bin.' >&2
  exit 127
fi

exec "$bun" --no-env-file --config="$repo/bunfig.toml" "$repo/src/cli.ts" "$@"
